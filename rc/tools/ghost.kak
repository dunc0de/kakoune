# ghost.kak — WebSocket ghost-text streaming module
#
# Streams per-token ghost text from a WebSocket bridge (the ghost-text-agent
# repo) into the editor as inline ghost text. The engine is
# transport-agnostic (base64 decode, Kak key-layer escaping, fail-closed
# injection guard, atomic first-delta mkdir lock, span accumulation); the
# draft-state blocks keep state in scratch-dir files, not options, and drift
# validation is disabled (see the per-block notes). The transport is a
# detached python3-stdlib RFC6455 tailer (rc/tools/ghost_ws.py).
# Self-contained Kakoune module; loaded lazily at session
# start via a KakBegin hook (options are declared inside the module body, so
# they only exist after require-module ghost runs).

provide-module ghost %{

    # Configuration (user-facing)
    declare-option -docstring "WebSocket URL of the ghost-text bridge (e.g. ws://127.0.0.1:8080/ws)" \
        str ghost_ws_url "ws://127.0.0.1:8080/ws"
    declare-option -docstring "timeout seconds for kak -p dispatches from the tailer" \
        int ghost_ws_timeout 5
    declare-option -docstring "seconds between control-file polls in the tailer" \
        str ghost_ws_control_poll "0.1"
    declare-option -docstring "path to the ghost_ws.py tailer script (default: <runtime>/rc/tools/ghost_ws.py; auto-set to the resolved path when a session starts)" \
        str ghost_ws_py ""

    # Hidden per-session state
    declare-option -hidden \
        str ghost_dir ""
    declare-option -hidden \
        int ghost_pid 0
    # The live Kakoune session name. Resolved via a set-option global emitted
    # OUTSIDE %sh{} (Kakoune parses %val{session} into the real name there);
    # read back inside %sh{} via $kak_opt_ghost_session_name, because %val{} is
    # literal inside %sh{} bodies — every `kak -p <session>` dispatch below
    # depends on this resolving correctly instead of `-p ""`.
    declare-option -hidden \
        str ghost_session_name ""
    declare-option -hidden \
        str ghost_client ""
    # The bridge session id, generated by the ghost-session launcher. Carried
    # in every user_control frame and matched against inbound ghost_text
    # frames by the tailer.
    declare-option -hidden \
        str ghost_session_id ""
    # The per-session control file (<ghost_dir>/control.jsonl). ghost-control
    # appends one JSON line per control; the tailer polls it and ships each
    # line as a user_control frame.
    declare-option -hidden \
        str ghost_control_file ""

    # Draft span state (start/anchor/active) is NOT held in options; it lives in
    # files in the scratch dir (<ghost_dir>/.start, .anchor, .active), written by
    # ghost-append-delta and read by ghost-accept / ghost-reject (see the notes in
    # each command body). The three ghost_draft_* options below are RETIRED --
    # declared only because the regression test rc files (test/regression/ghost/*)
    # still set them; the module neither reads nor writes them.
    declare-option -hidden \
        str ghost_draft_start ""
    declare-option -hidden \
        str ghost_draft_anchor ""
    declare-option -hidden \
        bool ghost_draft_active false
}

# The module body (option declarations) only runs on require-module. Wire it to
# KakBegin so options exist for the whole session — mirrors rc/tools/fifo.kak.
hook -once global KakBegin .* %{ require-module ghost }
# Tear down a running tailer at session end so the detached python process and
# its scratch dir are never orphaned. ghost-stop is a no-op when nothing is
# running, so the hook is always safe. (The ghost tailer is a long-lived
# detached process, so this module registers the hook itself rather than
# leaving it to the user's rcfile.)
hook -once global KakEnd .* %{ ghost-stop }

# Each %sh{} body runs in its own isolated shell, so helpers such as kak_send
# must be redefined per body — a top-level function def parses as a Kakoune
# command, not a shell function. ${kak_session} expands within that shell.

define-command -hidden -params ..1 -docstring %{
    ghost-append-delta <delta>: transport entry point for a base64-encoded ghost_text frame;
    owns Kak key-layer escaping and fail-closed injection guard.
} ghost-append-delta %{
    # Dispatched by the tailer as
    #   `evaluate-commands -client <id> ghost-append-delta '<b64>'` on Kakoune's
    #   `-ui json` stdin — already inside that client context.
    #
    # Design: shell-safe work (base64 decode, kak key-layer escaping, injection
    # guard, cursor-drift decision) runs INSIDE %sh{} where /bin/sh can execute
    # `base64`, `awk`, `grep` and read the `kak_*`/`kak_opt_*` options. The escaped
    # delta is published to a hidden option via a LITERAL `set-option global` command
    # emitted through kak_send(), because calling `set-option` directly inside %sh{}
    # fails with "command not found" (it is not a shell binary). All buffer/state
    # mutations then run as LITERAL Kakoune commands OUTSIDE %sh{}, referencing
    # %opt{ghost_delta_esc} / %val{cursor_*} which Kakoune expands at evaluation time.
    # This avoids the broken `evaluate-commands %sh{ printf lines }` re-parse path
    # entirely (probe23 proves stdout is NOT re-parsed in this build).
    evaluate-commands %sh{
        # %sh{} bodies run in isolated POSIX shells, so kak_send is redefined here
        # (a Kakoune command cannot be called from inside %sh{}).
        kak_send() { printf 'evaluate-commands -client "%s" %s\n' "${kak_opt_ghost_client}" "$1" | kak -p "${kak_session}"; }
        if ! delta=$(printf '%s' "$1" | base64 -d); then
            printf '%s\n' '{Error}ghost-append-delta: invalid base64 delta; dropping' > "${GHOST_GUARD_ERR_FILE:-/dev/null}"
            exit 0
        fi
        # Decode the base64-encoded delta back to its raw bytes verbatim. The tailer
        # guarantees ONE base64 line; this recovers the exact delta (which may contain
        # LF, tab, <lt>, etc.) before kak-layer escaping. base64 output has no shell
        # metacharacters, so $1 is safe inside single quotes.

        # --- Kak key-layer escaping (single source). ---
        # Escape raw < FIRST (so the < of the named-key escapes below is never itself
        # escaped), then the named-key escapes. Raw space is a key separator in
        # execute-keys (not inserted) and a raw tab byte cannot be inserted, so both are
        # rendered as named keys; LF -> <ret>. Backslash is treated VERBATIM by kak (1 in
        # -> 1 out), so it needs NO kak-layer escaping -- only the socket shell layer
        # (handled by the tailer). This fixes the prototype's over-escaping of `\`.
        esc=$(printf '%s' "$delta" | awk '
            BEGIN { RS = "\0"; ORS = "" }
            {
                s = $0
                gsub(/</, "<lt>", s)     # < -> <lt>
                gsub(/ /, "<space>", s)  # SPACE -> <space>
                gsub(/\t/, "<tab>", s)   # TAB -> <tab>
                gsub(/\n/, "<ret>", s)   # LF -> <ret>
                printf "%s", s
            }')

        # --- Guard against injection (whitelist, backslash allowed). ---
        # Reject deltas whose escaped form can break out of the single-quoted
        # command string or reach an executable shell layer:
        #   control bytes       -> malformed command / stray newline injection
        #   %{} ; | &           -> command grouping / chaining / param expansion
        #   $ ` "               -> shell interpolation / command substitution / quoting
        # Backslash is intentionally NOT rejected: the awk layer passes it
        # verbatim and Kak treats it 1:1 (a previous blacklist dropped legitimate
        # completions such as C:\Users\x). `[[:cntrl:]]` still catches any raw
        # control byte the awk layer missed.
        # A literal single quote is the one char that breaks single-quoting, so it
        # must be rejected too (otherwise `don't` / `C++'s` terminates the quoted
        # argument and injects bytes into Kakoune's command layer over the socket).
        # Build the guard pattern across three assignments so both the double
        # and single quotes land literally inside one bracket expression. A
        # single-quoted literal ending in `"` followed by a bare `'` then `]`
        # avoids the POSIX parse error that the previous inline
        # `[[:cntrl:]%{};|&$"'"']` form hit: the first `'...'` closes, then an
        # unbalanced `"` aborts /bin/sh with "unexpected EOF", so the guard
        # never fired and no delta was ever inserted via this path.
        guard='[[:cntrl:]%{};|&$"'
        guard="${guard}'"
        guard="${guard}]"
        if printf '%s' "$esc" | LC_ALL=C grep -Eq "$guard"; then
            printf '%s\n' '{Error}ghost-append-delta: fail-closed; command-metacharacter or control byte in delta; dropping' > "${GHOST_GUARD_ERR_FILE:-/dev/null}"
            exit 0
        fi

        # --- Cursor-drift validation disabled due to async anchor update race ---
        # Anchor is updated asynchronously via kak_send; the next delta can see a stale anchor
        # and be dropped. Drift validation is intentionally fail-closed for now to avoid false
        # negatives until anchor delivery is synchronous.
        # First delta of the stream initialises start/activate. Use
        # kak_send because evaluate-commands %sh{} stdout is NOT re-parsed in this
        # build (probe23), so Kakoune commands must be sent via kak -p.
        # Kakoune has no `if` command, so conditionals must live inside %sh{} where
        # POSIX `if [ ]` works.
        # Atomic first-delta init: mkdir is atomic, so only the FIRST %sh{} body
        # to run wins. The lock dir is intentionally NOT removed here -- removing
        # it (the previous rmdir) made the lock re-entrant, so a later delta won it
        # again and overwrote .start with its own (post-insert) cursor, corrupting
        # the span. The lock dir now persists until ghost-stop removes the scratch
        # dir, so .start is captured exactly once, by the first delta.
        if mkdir "${kak_opt_ghost_dir}/.pre_init_lock" 2>/dev/null; then
            # Draft state lives in files in the scratch dir, written synchronously
            # in this %sh body and read directly by ghost-reject/ghost-accept.
            # A buffer-scoped set-option sent via kak -p is queued and processed in
            # a different context than the reject's %sh read, so kak_opt_* came back
            # empty and the arithmetic ($((s_col + ...)) on an empty s_col) killed
            # the body before the anchor was stored -- the reject then no-op'd.
            printf '%s %s' "${kak_cursor_line}" "${kak_cursor_column}" > "${kak_opt_ghost_dir}/.start" 2>/dev/null || true
            printf 'true' > "${kak_opt_ghost_dir}/.active" 2>/dev/null || true
            # pre.txt is a disk-side first-commit marker: the e2e harness
            # (test/e2e/ghost_e2e.py) polls for it to detect that the first
            # delta committed. It is NOT read for span math -- reject derives
            # the erase span purely from .start/.anchor.
            : > "${kak_opt_ghost_dir}/pre.txt"
        fi
        # Insert within a draft context, then set the anchor from the CALLING context
        # (where global options persist) using the delta content we already hold --
        # no draft-context cursor, no file, no race. The draft context CANNOT set the
        # anchor: (a) Kakoune expands %line/%column/%val{...} at PARSE time (before the
        # draft runs), so an inline `set-option ... '%line %column'` pins the anchor to
        # the pre-insert cursor (start+1, e.g. "1 2"); (b) a set-option emitted from
        # inside the draft context is rolled back when the draft commits; and (c) a
        # %sh{} body's file write is async -- kak -p returns before it lands, so a
        # file-based capture races the next read and sees an empty anchor.
        #
        # The anchor is the position right after the inserted delta (what ghost-reject's
        # erase-span math expects). Each delta inserts at the CURRENT cursor (not at the
        # span start), so the anchor must be computed from the current cursor + the delta
        # content -- NOT from the stored start (a later delta's current cursor is already
        # past the earlier deltas, so start+len undershoots the true end):
        #   no newlines   -> (cur_line, cur_col + len)
        #   N newlines    -> (cur_line + N, 1 + len-after-last-newline)
        kak_send "evaluate-commands -draft %{ execute-keys '<i>${esc}<esc>l' }"
        cur_line="${kak_cursor_line}"
        cur_col="${kak_cursor_column}"
        delta_len=$(printf '%s' "$delta" | wc -c)
        nl_count=$(printf '%s' "$delta" | wc -l)
        if [ "$nl_count" -eq 0 ]; then
            a_line=$cur_line
            a_col=$((cur_col + delta_len))
        else
            a_line=$((cur_line + nl_count))
            a_col=$((1 + $(printf '%s' "$delta" | awk 'END{print length($0)}')))
        fi
        printf '%s %s' "$a_line" "$a_col" > "${kak_opt_ghost_dir}/.anchor" 2>/dev/null || true
    }
    # The insert and anchor update happened inside the %sh body above (kak_send
    # + direct file write), so just yield to let Kakoune process the draft
    # commit before the next delta arrives.
    evaluate-commands %sh{ sleep 0.1 }
    # Force a UI redraw: draft contexts emit refresh [false], so the inserted
    # text needs a manual redraw to become visible.
    execute-keys <c-l>
    execute-keys <c-l>
}

# ---------------------------------------------------------------------------
# Draft state teardown
# ---------------------------------------------------------------------------

# ghost-draft-clear: reset the ghost-text draft state to its empty baseline.
# Single source of truth for the draft-state teardown, shared by ghost-accept,
# ghost-reject and ghost-stop (each calls `kak_send ghost-draft-clear`). Removes
# the scratch-dir state files only — never touches the buffer, so it is safe to
# call on either the no-op path or the normal path.
define-command -hidden -docstring %{
    ghost-draft-clear: remove the ghost draft state files (.start/.anchor/.active) from the scratch dir.
} ghost-draft-clear %{
    evaluate-commands %sh{
        rm -f "${kak_opt_ghost_dir}/.start" "${kak_opt_ghost_dir}/.anchor" "${kak_opt_ghost_dir}/.active"
    }
}

# ---------------------------------------------------------------------------
# Accept / reject — select / erase the accumulated ghost-text span
# ---------------------------------------------------------------------------
# Operate on the range [start, anchor] established by ghost-append-delta.
# Stored coords are "line column" (space); split them with POSIX word-
# splitting (`set --`) inside the %sh body — the reject span math is derived
# purely from start/anchor, no buffer snapshot or awk needed.
# All %sh bodies run in Kakoune's /usr/bin/sh (POSIX) — no bashisms.

# ghost-accept: select the accumulated ghost draft span (start -> anchor) and
# deactivate draft tracking. The -draft inserts were already committed incrementally
# (one undo node per delta), so there is no undo-group fold: a single `undo` removes only
# the last delta, and repeated or manual multi-step undo clears the whole span. The
# absolute-range `select` here repositions the cursor and selects the span; it does not
# insert or delete text. No-op when no draft is active.
define-command -docstring %{
    ghost-accept: select the accumulated ghost draft span (start -> anchor) and
    deactivate draft tracking. The text was inserted incrementally as separate undo nodes,
    so this is no undo-group fold: a single `undo` removes only the last delta. The
    absolute-range `select` repositions the cursor and selects the span (it does not insert
    or delete text). No-op when no draft is active.
} ghost-accept %{
    evaluate-commands %sh{
        kak_send() { printf '%s\n' "$1" | kak -p "${kak_session}"; }
        active=$(cat "${kak_opt_ghost_dir}/.active" 2>/dev/null)
        if [ "$active" != "true" ]; then
            kak_send "echo -markup '{Warning}ghost-accept: no active draft'"
            exit 0
        fi
        start=$(cat "${kak_opt_ghost_dir}/.start" 2>/dev/null)
        anchor=$(cat "${kak_opt_ghost_dir}/.anchor" 2>/dev/null)
        # No text was actually inserted (anchor unset, or cursor never moved):
        # just deactivate.
        if [ -z "${anchor}" ] || [ "${start}" = "${anchor}" ]; then
            kak_send "ghost-draft-clear"
            exit 0
        fi
        # Split the stored "line column" coords with POSIX word-splitting (no
        # external awk) — the %sh body runs in /usr/bin/sh (see file header).
        set -- ${start}; s_line=$1; s_col=$2
        set -- ${anchor}; a_line=$1; a_col=$2
        if [ "$a_col" = "1" ]; then
            # Cross-line anchor at column 1: select up to end of previous line
            # to avoid including the first character of the next line.
            prev_line=$((a_line-1))
            sel_end="${prev_line}.999999"
        else
            sel_end="${a_line}.${a_col}"
        fi
        kak_send "evaluate-commands -client ${kak_opt_ghost_client} %{
            select ${s_line}.${s_col},${sel_end}
        }"
        # Deactivate; the text now lives in the buffer as separate undo nodes.
        kak_send "ghost-draft-clear"
    }
}

# ghost-reject: erase the accumulated ghost draft span (start -> anchor) with a
# single `execute-keys d`, so one `undo` restores the whole span. The draft text was
# inserted incrementally as separate undo nodes; this erase is its own undo node. No-op
# when no draft is active.
define-command -docstring %{
    ghost-reject: erase the accumulated ghost draft span with a single `execute-keys d`,
    so one `undo` restores the original buffer. No-op when no draft is active.
} ghost-reject %{
    evaluate-commands %sh{
        kak_send() { printf '%s\n' "$1" | kak -p "${kak_session}"; }
        active=$(cat "${kak_opt_ghost_dir}/.active" 2>/dev/null)
        if [ "$active" != "true" ]; then
            kak_send "echo -markup '{Warning}ghost-reject: no active draft'"
            exit 0
        fi
        start=$(cat "${kak_opt_ghost_dir}/.start" 2>/dev/null)
        anchor=$(cat "${kak_opt_ghost_dir}/.anchor" 2>/dev/null)
        if [ -z "${anchor}" ] || [ "${start}" = "${anchor}" ]; then
            kak_send "ghost-draft-clear"
            exit 0
        fi
        set -- ${start}; s_line=$1; s_col=$2
        set -- ${anchor}; a_line=$1; a_col=$2
        # The erase span is derived directly from the start/anchor state, NOT
        # from a live buffer snapshot. A snapshot would require a `write` sent
        # via kak -p, which is queued and only processed after this %sh body
        # finishes -- so the snapshot is still empty (0 bytes) when read here,
        # and the old `! -s` guard made the reject exit before the erase ever ran.
        # `select L1 C1 L2 C2` erases columns C1..C2 inclusive, so the end
        # coordinate is the last ghost byte:
        #   - same line, or anchor on a later line with a_col>1: end = (a_line, a_col-1).
        #   - anchor on a later line with a_col==1: the ghost ends right before
        #     the next line; selecting to (a_line, 1) includes that trailing
        #     newline as the last erased byte (no line-length lookup needed).
        # `select` takes comma-separated coordinates in LINE.COLUMN,LINE.COLUMN
        # form: anchor_line.anchor_column,cursor_line.cursor_column. The anchor is
        # the draft start (first ghost byte) and the cursor is the last ghost byte
        # (a_col-1, since the anchor column is one past the last inserted byte).
        if [ "$a_line" = "$s_line" ]; then
            sel="select ${s_line}.${s_col},${a_line}.$((a_col-1))"
        elif [ "$a_col" = "1" ]; then
            # Cross-line with a_col==1: the ghost ends at the newline after line a_line-1.
            # Kakoune's select is inclusive, so selecting to (a_line,1) would also
            # consume the first character of the next line. We select to the end of
            # the previous line using a very large column number which Kakoune clamps
            # to the line end, effectively erasing up to (but not including) (a_line,1).
            prev_line=$((a_line-1))
            sel="select ${s_line}.${s_col},${prev_line}.999999"
        else
            sel="select ${s_line}.${s_col},${a_line}.$((a_col-1))"
        fi
        # `execute-keys d` erases the selected span in one undo node (there is no
        # `delete` command; only the d key can erase selections).
        kak_send "evaluate-commands -client ${kak_opt_ghost_client} %{
            ${sel}
            execute-keys d
        }"
        kak_send "ghost-draft-clear"
    }
}

# Keybindings (documented only — NOT auto-bound). CAUTION: the user layer is
# checked BEFORE the builtin layer, so `map global user a` would SHADOW the
# builtin `a` (append) and break normal-mode append globally; use
# non-conflicting keys instead, e.g.:
#   map global user <a-g><a-a> ':<space>ghost-accept<ret>'    # commit ghost text
#   map global user <a-g><a-r> ':<space>ghost-reject<ret>'    # discard ghost text
# ---------------------------------------------------------------------------
# Session lifecycle: ghost-session / ghost-control / ghost-stop
# ---------------------------------------------------------------------------
#
# The detached child is the python3-stdlib WebSocket tailer (ghost_ws.py);
# the control back-channel is a per-session control file (control.jsonl) that
# the tailer polls, promoted from a drift door to the user-control channel.

define-command -params ..1 -docstring %{
    ghost-session [ws-url]: start a detached ghost text stream from the
    WebSocket bridge at ws-url (default: $ghost_ws_url) and stream its tokens
    into the editor. Fails if a session is already running or python3 is
    missing. The bridge (ghost-text-agent) must already be running; this
    command never starts it.
} ghost-session %{
    # %val{} here expands at PARSE time; the unquoted form is required so the
    # options store the bare session/client names, not the literal text
    # "%val{session}" (every `kak -p` dispatch below depends on this
    # resolving to the real session name).
    set-option global ghost_session_name %val{session}
    set-option global ghost_client %val{client}
    evaluate-commands %sh{
        # %sh{} bodies run in isolated POSIX shells, so kak_send is redefined
        # here and the resolved names are read back via $kak_opt_* (Kakoune
        # exports options as kak_opt_<name> env vars into %sh{}).
        kak_session="${kak_opt_ghost_session_name}"
        kak_client="${kak_opt_ghost_client}"
        kak_send() { printf '%s\n' "$1" | kak -p "${kak_session}"; }

        ws_url="${1-}"
        [ -z "${ws_url}" ] && ws_url="${kak_opt_ghost_ws_url}"
        case "${ws_url}" in
            ws://*) : ;;
            *) kak_send "echo 'fail ghost-session: ws-url must be ws://... (got ${ws_url})'"
               exit 0 ;;
        esac

        # Guard: one ghost session per Kakoune instance.
        if [ "${kak_opt_ghost_pid}" != "0" ]; then
            kak_send "echo 'fail a ghost session is already running (pid ${kak_opt_ghost_pid})'"
            exit 0
        fi

        # python3 is a hard dependency (uuid generation AND the tailer itself).
        if ! command -v python3 >/dev/null 2>&1; then
            kak_send "echo 'fail python3 not found on PATH; the ghost tailer requires it'"
            exit 0
        fi
        session_id=$(python3 -c 'import uuid; print(uuid.uuid4())' 2>/dev/null)
        if [ -z "${session_id}" ]; then
            kak_send "echo 'fail ghost-session: could not generate a session id'"
            exit 0
        fi

        # Per-session 0700 scratch dir (mktemp -d already creates 0700; chmod
        # makes it explicit). The control file starts EMPTY so the tailer's
        # offset poll sees nothing until ghost-control appends.
        dir=$(mktemp -d "${TMPDIR:-/tmp}"/kak-ghost.XXXXXXXX)
        chmod 0700 "${dir}"
        : > "${dir}/control.jsonl"

        # Shared teardown helper for the post-setup failure paths: remove the
        # scratch dir, notify the user, exit.
        fail() {
            rm -rf "${dir}"
            kak_send "$1"
            exit 0
        }

        # Resolve the tailer script: the $ghost_ws_py option wins; the default
        # sits next to this module in the runtime tree. %val{runtime} is
        # expanded by Kakoune BEFORE the shell runs, so the shell sees a plain
        # path in the default.
        # An explicit if-test is used instead of a ${var:-default} expansion because the
        # POSIX %sh{} shell mis-parses a default beginning with % (the :-%
        # sequence mangles the value), so the two branches are kept separate.
        if [ -z "${kak_opt_ghost_ws_py}" ]; then
            ws_py="%val{runtime}/rc/tools/ghost_ws.py"
        else
            ws_py="${kak_opt_ghost_ws_py}"
        fi
        if [ ! -f "${ws_py}" ]; then
            fail "echo 'fail ghost_ws.py not found at ${ws_py}; set-option global ghost_ws_py <path>'"
        fi

        # Launch the tailer detached in its OWN session via setsid so
        # ghost-stop can process-group-kill it without ever reaching Kakoune.
        # `trap - INT QUIT` restores default dispositions; `exec` hands the
        # subshell PID to python3 so $! == PGID.
        #
        # IMPORTANT: exported in THIS (parent) shell BEFORE setsid -- the
        # detached process inherits only real environment variables, not the
        # parent shell's locals.
        export GHOST_WS_URL="${ws_url}"
        export GHOST_SESSION_ID="${session_id}"
        export GHOST_DIR="${dir}"
        export GHOST_CLIENT="${kak_client}"
        export kak_session="${kak_session}"
        export GHOST_WS_TIMEOUT="${kak_opt_ghost_ws_timeout}"
        export GHOST_WS_CONTROL_POLL="${kak_opt_ghost_ws_control_poll}"
        ( trap - INT QUIT
          exec setsid python3 "${ws_py}" ) >/dev/null 2>"${dir}/.ghost_tailer.stderr" < /dev/null &
        tpid=$!

        # Liveness check: an exec failure (bad interpreter race) would
        # otherwise leave a dead PID recorded below. 5 x 50ms poll budget
        # (literals by design).
        alive=0
        _retry=0
        while [ "${_retry}" -lt 5 ]; do
            _retry=$((_retry + 1))
            if kill -0 "${tpid}" 2>/dev/null; then alive=1; break; fi
            sleep 0.05
        done
        if [ "${alive}" -ne 1 ]; then
            fail "echo 'fail ghost tailer did not start (pid ${tpid} not alive)'"
        fi

        # Record state via kak_send OUTSIDE the %sh shell: the detached
        # tailer inherits its own -client, so the LAUNCHING client is
        # recorded here for write-back.
        kak_send "set-option global ghost_dir '${dir}'"
        kak_send "set-option global ghost_pid '${tpid}'"
        kak_send "set-option global ghost_session_id '${session_id}'"
        kak_send "set-option global ghost_control_file '${dir}/control.jsonl'"
        kak_send "set-option global ghost_ws_url '${ws_url}'"
        kak_send "set-option global ghost_ws_py '${ws_py}'"
        kak_send "echo -markup '{Information}ghost session started (pid ${tpid}, id ${session_id})'"
    }
}

# ghost-control <CTRL>: ship a user control to the bridge. Appends one JSON
# line to the per-session control file; the tailer polls it (<= poll interval)
# and ships it as a user_control frame carrying the bound sessionId. STOP also
# tears the session down -- the tailer ships STOP on SIGTERM as well, so the
# bridge sees a STOP in every ordering.
define-command -params 1 -docstring %{
    ghost-control <ACCEPT|REJECT|PAUSE|START|STOP>: send a user control to the
    ghost text bridge. STOP also stops the session. Fails when none is running.
} ghost-control %{
    evaluate-commands %sh{
        kak_session="${kak_opt_ghost_session_name}"
        kak_send() { printf '%s\n' "$1" | kak -p "${kak_session}"; }
        ctrl="${1-}"
        case "${ctrl}" in
            ACCEPT|REJECT|PAUSE|START|STOP) : ;;
            *) kak_send "echo 'fail ghost-control: unknown control ${ctrl} (ACCEPT|REJECT|PAUSE|START|STOP)'"
               exit 0 ;;
        esac
        dir="${kak_opt_ghost_dir}"
        if [ -z "${dir}" ] || [ "${kak_opt_ghost_pid}" = "0" ]; then
            kak_send "echo 'fail no ghost session running (use ghost-session)'"
            exit 0
        fi
        # CTRL is from a closed case set -- safe unquoted in the JSON line.
        printf '{"control":"%s"}\n' "${ctrl}" >> "${dir}/control.jsonl"
        if [ "${ctrl}" = "STOP" ]; then
            # ghost-stop SIGTERMs the tailer; its handler ships STOP regardless
            # of whether this line was already polled (see design notes).
            kak_send "ghost-stop"
        else
            kak_send "echo -markup '{Information}ghost control ${ctrl} sent'"
        fi
    }
}

# ghost-stop: stop the running ghost session. SIGTERM FIRST (the tailer's
# handler ships a final STOP frame + WS close within one poll interval), a
# 0.5s grace period, then SIGKILL if still alive. Removes the scratch dir,
# resets draft state via ghost-draft-clear, and clears the state options.
# Idempotent no-op when nothing is running -- safe from keymaps, from
# ghost-control STOP, from the tailer's self-teardown dispatch, and from the
# KakEnd hook.
define-command -docstring %{
    ghost-stop: stop the running ghost session (graceful SIGTERM, then
    SIGKILL), remove its scratch dir, and clear its state. No-op if none running.
} ghost-stop %{
    evaluate-commands %sh{
        kak_session="${kak_opt_ghost_session_name}"
        kak_send() { printf '%s\n' "$1" | kak -p "${kak_session}"; }
        cur_pid="${kak_opt_ghost_pid}"
        cur_dir="${kak_opt_ghost_dir}"

        clear_state() {
            rm -rf "${cur_dir}"
            kak_send "ghost-draft-clear"
            kak_send "set-option global ghost_dir ''"
            kak_send "set-option global ghost_pid 0"
            kak_send "set-option global ghost_session_id ''"
            kak_send "set-option global ghost_ws_url ''"
            kak_send "set-option global ghost_control_file ''"
            kak_send "echo -markup '{Information}ghost session stopped'"
        }

        if [ "${cur_pid}" = "0" ] || [ -z "${cur_dir}" ]; then
            kak_send "echo -markup '{Information}no ghost session running'"
            exit 0
        fi

        # Resolve a safe process-group kill target BEFORE killing: only
        # group-kill when the recorded PID is
        # alive AND is its own process-group leader (setsid guarantees this);
        # otherwise fall back to pgrep on the resolved tailer path (the
        # tailer's argv is `python3 <ws_py>` -- GHOST_DIR lives only in env,
        # not argv, so the path is the only pgrep anchor).
        kill_target=""
        if kill -0 "${cur_pid}" 2>/dev/null; then
            _pid_pgid=$(ps -o pgid= -p "${cur_pid}" 2>/dev/null | tr -d ' ')
            if [ "${_pid_pgid}" = "${cur_pid}" ]; then
                kill_target="${cur_pid}"
            fi
        fi
        if [ -z "${kill_target}" ]; then
            _ws_py_re=$(printf '%s' "${kak_opt_ghost_ws_py}" | sed 's/[.[\*^$+?()]/\\&/g')
            kill_target=$(pgrep -f "${_ws_py_re}" 2>/dev/null | head -1)
        fi
        if [ -z "${kill_target}" ]; then
            # Process already gone (e.g. the tailer's handshake-failure
            # self-teardown raced us): clean state only.
            clear_state
            exit 0
        fi

        # Graceful first: the tailer's SIGTERM handler ships STOP + WS close.
        kill -TERM "-${kill_target}" 2>/dev/null
        # Grace budget: one control-poll interval (0.1s) + slack for the
        # STOP frame to reach the bridge.
        sleep 0.5
        if kill -0 "${kill_target}" 2>/dev/null; then
            kill -KILL "-${kill_target}" 2>/dev/null
        fi

        clear_state
    }
}
