#!/bin/sh
# Regression: the injection guard must NOT drop backslash-containing
# completions. Backslash is Kak-safe -- the awk layer passes it verbatim and
# Kak treats it 1:1 -- so `C:\Users\x` must pass the guard, while proven
# injection metacharacters still do not (ghost-command-injection-guard covers
# those).
#
# Payload (base64-encoded):  C:\Users\x
#   - backslash -> allowed (a guard that blacklists `\` would drop the delta
#     and write the fail-closed {Error} message -> FAIL)
#
# Discriminator: the deterministic capture file (GHOST_GUARD_ERR_FILE, fed to
# the kak server via the fixture env file). Guard allows backslash -> no
# {Error} emitted -> PASS. The byte-faithful round-trip insertion path itself
# is covered by the Slice 8 e2e stream test; this test targets the guard.
KAK="$kak"
errfile="$PWD/gerr"
if [ ! -f env ]; then fail_ifn; fi
rm -f "$errfile"

# Fire the guard with a backslash-containing completion.
$KAK -p kak-tests <<EOF
evaluate-commands -client client0 ghost-append-delta $(printf '%s' 'C:\Users\x' | base64 | tr -d '\n')
EOF
sleep 0.3

# Gate: the guard did NOT emit its fail-closed {Error} -> backslash allowed.
if grep -q '{Error}' "$errfile" 2>/dev/null; then fail_ifn; fi
