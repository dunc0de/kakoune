#!/bin/sh
KAK="$kak"
# Leave the cursor at its default position (1:1), which equals the stored
# draft anchor (1:1) -- in-sync with the draft. (Drift validation is currently
# disabled in ghost.kak due to the async anchor-update race; the fixture keeps
# the cursor in-sync so it stays valid if that check is re-enabled.) The
# delta commits -> "ZOOx BAR y".
$KAK -p kak-tests <<EOF
evaluate-commands -client client0 ghost-append-delta Wk9P
EOF
sleep 0.3
# Correctness of the live buffer is enforced by the harness itself: it writes the
# final buffer to `out` (via write -force in finished_commands) and compares it
# against this dir's `out`. %val{bufcontent} is undefined in Kakoune, so we do not
# read it here; the generated-out comparison is the discriminator (a failed
# commit never reaches execute-keys -> no ghost text -> FAIL).
