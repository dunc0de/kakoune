#!/bin/sh
# Same-line draft-mode reject: the ghost span (start 1.3 -> anchor 1.6) sits on
# a single line, so ghost-reject erases columns 3..5 ("BAR") in one `d` and one
# `u` restores the original buffer.
#
# The draft span state lives in FILES in the scratch dir ($kak_opt_ghost_dir),
# written synchronously by the production append-delta body and read directly by
# ghost-reject -- not in kak options (the span state is file-based in the
# production path; mirroring that keeps the fixture faithful and free of kak -p
# dispatch-timing dependencies). This fixture simulates the stream by creating
# exactly the files the reject reads. Correctness is enforced by the harness's
# generated-out comparison (the live buffer is written to `out` in
# finished_commands, after this script runs).
KAK="$kak"
sleep 0.4
D=$(mktemp -d)
printf 'true' > "$D/.active"
printf '1 3' > "$D/.start"
printf '1 6' > "$D/.anchor"
$KAK -p kak-tests <<INNER
set-option global ghost_dir "$D"
set-option global ghost_client client0
INNER
$KAK -p kak-tests <<INNER
evaluate-commands -client client0 ghost-reject
INNER
sleep 0.3
