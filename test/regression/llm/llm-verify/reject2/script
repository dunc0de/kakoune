#!/bin/sh
KAK="$kak"
sleep 0.4
D=$(mktemp -d)
printf 'x BAR\ny\n' > "$D/pre.txt"
$KAK -p kak-tests <<INNER
set-option global llm_dir "$D"
set-option global llm_draft_active true
set-option global llm_client client0
set-option global llm_draft_start "1,3"
set-option global llm_draft_anchor "2,1"
INNER
$KAK -p kak-tests <<INNER
evaluate-commands -client client0 llm-reject
INNER
sleep 0.3
